+	long := strings.Repeat("a", 1000)
+	sch := compileBudget(t, `{"const":{"a":"`+long+`","b":"x"}}`, false)
+	v := instance(t, `{"a":"`+long+`","b":"y"}`)
+	want := least(t, sch, v)
+	for i := 0; i < 30; i++ {
+		if got := least(t, sch, v); got != want {
+			t.Fatalf("comparing two objects took %d steps, then %d", want, got)
+		}
+	}
