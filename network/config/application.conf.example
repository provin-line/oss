# Example operator config for the `standalone` binary.
#
# The binary loads ./config/application.conf (relative to its working dir),
# layered over the packages' embedded reference.conf defaults, plus an optional
# overlay file named by the CONFIG_OVERLAY environment variable. Copy this to
# config/application.conf and fill the two values that have no default — the
# binary fails closed at boot until both are set.

provin.network {

  # REQUIRED — no default. The authorization decision point (o3co policy
  # verifier). Must carry an explicit http:// or https:// scheme.
  auth.policy-verifier-url = "https://auth.example.internal/policy"

  registry {
    # REQUIRED — no default. The did:dplaax {registry} segment this server is
    # authoritative for; appears in every DID it mints and resolves. Must be a
    # valid DID segment ([A-Za-z0-9._-], not all dots).
    id = "poc.dplaax.dev"

    # OPTIONAL. Service endpoints embedded in every issued Pipeline/Process DID
    # Document, keyed by endpoint id (the key becomes the "#<id>" fragment).
    service-endpoints {
      # vc-resolver { type = "VCResolver", url = "https://poc.dplaax.dev/vc" }
    }
  }

  # OPTIONAL (defaults shown). Listen address and durable-state root; stores
  # live under data-dir in dids/ , schemas/ , keys/ subdirs.
  #
  # The default listen-addr is loopback-only (secure by default). Exposing the
  # node on a non-loopback interface serves cleartext h2c (bearer tokens in the
  # clear), so the boot guard fails closed unless you choose a transport
  # posture — either node-native TLS (tls.cert-file/key-file) or an explicit
  # tls.allow-cleartext=true behind a real TLS terminator with an isolated
  # backend. See docs/architecture/deployment.md "TLS termination".
  core {
    listen-addr = "127.0.0.1:8443"
    data-dir    = "./data"
    # To expose on a non-loopback interface, uncomment ONE posture:
    #   tls { cert-file = "/etc/provin/tls.crt", key-file = "/etc/provin/tls.key" }
    #   tls.allow-cleartext = true   # only behind a TLS terminator + isolated backend
    # and set listen-addr accordingly, e.g. ":8443".
  }
}
