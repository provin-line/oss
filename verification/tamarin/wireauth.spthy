/*
 * The L2 peer wire proof (network/pkg/services/chainmanager/wireauth), as a
 * Tamarin model.
 *
 * A request carries an op and its fields; its proof carries the signer DID,
 * the audience, a nonce, issuedAt and a signature over the view
 * <S, R, op, '2', n, t, f>, the terms of {signerDID, aud, op, v, nonce,
 * issuedAt, fields}. The verifier refuses a proof whose audience is not its
 * own, rebuilds the view with its own audience from the request it serves and
 * the proof, and checks the signature under the signer DID's #auth key.
 *
 * Contract (verification/README.md says the same):
 *   - the network is the attacker's (Dolev-Yao); the attacker makes DIDs of
 *     its own, and its DID document may list any key, an honest one included;
 *   - trusted: the verifier (never taken over), DID resolution (a DID's #auth
 *     key reaches the verifier as !AuthKey), signatures (no forgery without
 *     the key);
 *   - any key can be taken over (Compromise), and the model records it;
 *   - an honest signer draws a fresh nonce for each proof (wireauth.NewNonce,
 *     which every caller of wireauth.Sign uses); no_burn rests on it;
 *   - one verifier, with one nonce store and one audience (its node's registry
 *     ID), per network process; several verifiers may have one audience
 *     (replicas, each with a store of its own); the store's Use is an atomic
 *     check-and-set (restriction NonceStore);
 *   - a request is its op and its fields: a handler acts only on the fields it
 *     passes to Verify, and the op values are distinct across the surfaces
 *     that share the verifier;
 *   - an honest signer signs for whatever audience, op, issuedAt and fields it
 *     is handed;
 *   - no time: issuedAt is an opaque term of the view, and the store here
 *     never forgets; the acceptance window, the restart epoch, the eviction of
 *     nonces and restarts are left to a TLA+ model (NonceEpoch, not yet
 *     written);
 *   - not modelled: the fields' value grammar and the JCS bytes (vectors and
 *     fuzzing), the checks before the signature and authorization after it (a
 *     proof any of them refuses leaves the store as it was), key rotation;
 *   - the events are Accepted(V, R, S, op, n, t, f), verifier V, whose
 *     audience is R, accepted the proof (Verify returned nil and recorded the
 *     nonce); and ReplayRejected(V, R, S, op, n, t, f), the signature verified
 *     and the nonce was recorded already.
 *
 * Builds: the default build is the implementation under the premises above.
 * Each negative control changes one thing in it, and the lemmas it is
 * expected to falsify are in wireauth.expected.tsv:
 *   -D=ViewOmitsSigner  the view does not cover the signer DID (D-w1);
 *   -D=ViewOmitsAudience  the view does not cover the audience (D-w12);
 *   -D=ViewOmitsOp      the view does not cover the op;
 *   -D=AudienceFromWire  the verifier rebuilds the view with the audience the
 *                       proof names and does not compare it with its own;
 *   -D=NoNonceStore     no check-and-set: nothing stops a replay from being
 *                       accepted;
 *   -D=RecordBeforeSignature  a path that records the nonce before the
 *                       signature is checked;
 *   -D=StoreKeyedByNonce  the store is keyed by the nonce alone, not per
 *                       signer (D-w10).
 */
theory WireAuth
begin

builtins: signing

// The signed view: Sign and Accept build it through this one macro, as Sign
// and Verify build it through viewBytes. A negative control puts a constant
// in place of the term the view no longer covers. (The preprocessor does not
// nest #ifdef, hence one per term.)
#ifdef ViewOmitsSigner
macros: viewSigner(S) = 'omitted'
#else
macros: viewSigner(S) = S
#endif
#ifdef ViewOmitsAudience
macros: viewAud(R) = 'omitted'
#else
macros: viewAud(R) = R
#endif
#ifdef ViewOmitsOp
macros: viewOp(op) = 'omitted'
#else
macros: viewOp(op) = op
#endif
macros: view(S, R, op, n, t, f) = <viewSigner(S), viewAud(R), viewOp(op), '2', n, t, f>

// The nonce store's key: per signer (D-w10), as NonceStore.Use(signerDID,
// nonce).
#ifdef StoreKeyedByNonce
macros: slot(S, n) = n
#else
macros: slot(S, n) = <S, n>
#endif

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

// The store's check-and-set: a verifier records a key once. The store never
// forgets here; that forgetting after the window is safe is NonceEpoch's.
#ifdef NoNonceStore
#else
restriction NonceStore:
  "All V x #i #j. NonceUse(V, x) @ #i & NonceUse(V, x) @ #j ==> #i = #j"
#endif

// A DID document names one #auth key (no rotation).
restriction OneDocument:
  "All S x y #i #j. Bind(S, x) @ #i & Bind(S, y) @ #j ==> #i = #j"

/* ---------- Keys and DIDs ---------- */

rule Key:
    [ Fr(~k) ]
  --[ HonestKey(~k) ]->
    [ !Key(~k), Out(pk(~k)) ]

// An honest DID whose #auth key is k. Several DIDs may share one key.
rule HonestDID:
    [ !Key(k) ]
  --[ Bind($S, pk(k)), HonestDID($S, k) ]->
    [ !AuthKey($S, pk(k)), !Holds($S, k) ]

// A DID of the attacker's, whose document lists whatever key it likes.
rule AttackerDID:
    [ In(x) ]
  --[ Bind($A, x) ]->
    [ !AuthKey($A, x) ]

rule Compromise:
    [ !Key(k) ]
  --[ Compromised(k) ]->
    [ Out(k) ]

/* ---------- Signing and verifying ---------- */

// A verifier: one network process, whose audience is R (its node's registry
// ID). Several verifiers may have one audience (replicas).
rule Verifier:
    [ Fr(~V) ]
  --[ NewVerifier(~V, $R) ]->
    [ !Verifier(~V, $R) ]

// An honest signer signs for whatever audience, op, issuedAt and fields it is
// handed: the weakest assumption about what the node asks it to sign.
rule Sign:
    [ !Holds(S, k), Fr(~n), In(<R, op, t, f>) ]
  --[ Signed(S, R, op, ~n, t, f) ]->
    [ Out(<R, op, f, S, ~n, t, sign(view(S, R, op, ~n, t, f), k)>) ]

// Verify's order: the proof's audience is compared with the verifier's own,
// the signature is checked over the view rebuilt with that audience, and only
// then is the nonce recorded, last. (Structure, time and authorization are
// not modelled; a proof refused by any of them leaves the store as it was,
// which is what a rule that does not fire does.)
#ifdef AudienceFromWire
rule Accept:
    [ In(<Rw, op, f, S, n, t, sig>), !AuthKey(S, pkS), !Verifier(V, R) ]
  --[ Eq(verify(sig, view(S, Rw, op, n, t, f), pkS), true),
      NonceUse(V, slot(S, n)),
      Accepted(V, R, S, op, n, t, f) ]->
    [ !Spent(V, slot(S, n)) ]
#else
rule Accept:
    [ In(<R, op, f, S, n, t, sig>), !AuthKey(S, pkS), !Verifier(V, R) ]
  --[ Eq(verify(sig, view(S, R, op, n, t, f), pkS), true),
      NonceUse(V, slot(S, n)),
      Accepted(V, R, S, op, n, t, f) ]->
    [ !Spent(V, slot(S, n)) ]
#endif

// A proof for this verifier's audience whose signature verifies but whose
// nonce the store already holds: ErrReplay.
rule RejectReplay:
    [ In(<R, op, f, S, n, t, sig>), !AuthKey(S, pkS), !Verifier(V, R),
      !Spent(V, slot(S, n)) ]
  --[ Eq(verify(sig, view(S, R, op, n, t, f), pkS), true),
      ReplayRejected(V, R, S, op, n, t, f) ]->
    [ ]

#ifdef RecordBeforeSignature
// A verifier that records the nonce before it checks the signature: the
// proof is then turned away for its signature, but its nonce is spent.
rule RecordUnverified:
    [ In(<Rw, op, f, S, n, t, sig>), !Verifier(V, R) ]
  --[ NonceUse(V, slot(S, n)) ]->
    [ !Spent(V, slot(S, n)) ]
#endif

/* ---------- Lemmas ---------- */

// An honest DID's proof is accepted with no key compromised (reachability).
lemma executable_accept:
  exists-trace
  "Ex V R S k op n t f #b #i. HonestDID(S, k) @ #b
     & Accepted(V, R, S, op, n, t, f) @ #i
     & not (Ex k2 #r. Compromised(k2) @ #r)"

// Two honest DIDs on one key each have a proof accepted: aliases are live,
// so view_binding speaks about them.
lemma executable_alias:
  exists-trace
  "Ex V R S1 S2 k op1 n1 t1 f1 op2 n2 t2 f2 #b1 #b2 #i #j.
     HonestDID(S1, k) @ #b1 & HonestDID(S2, k) @ #b2 & not (S1 = S2)
     & Accepted(V, R, S1, op1, n1, t1, f1) @ #i
     & Accepted(V, R, S2, op2, n2, t2, f2) @ #j
     & not (Ex k2 #r. Compromised(k2) @ #r)"

// With its key taken over, an honest DID has a proof accepted that it never
// signed: the exception in view_binding is live.
lemma forgery_after_compromise:
  exists-trace
  "Ex V R S k op n t f #b #i. HonestDID(S, k) @ #b
     & Accepted(V, R, S, op, n, t, f) @ #i
     & not (Ex R2 #j. Signed(S, R2, op, n, t, f) @ #j)"

// (1) A proof accepted for DID S under an honest key k that was not taken
// over was signed by S, for this op, nonce, issuedAt and fields: a signature
// is reused neither for another DID that names the same key (the attacker's
// or an honest alias) nor for another op. (Which audience it was signed for
// is accepted_only_for_audience's.)
lemma view_binding:
  "All V R S op n t f k #i #b #h. Accepted(V, R, S, op, n, t, f) @ #i
     & Bind(S, pk(k)) @ #b & HonestKey(k) @ #h
     & not (Ex #r. Compromised(k) @ #r & #r < #i)
     ==> Ex R2 #j. Signed(S, R2, op, n, t, f) @ #j & #j < #i"

// (D-w12) A proof accepted at a verifier whose audience is R, under an honest
// key not taken over, was signed for R: a proof made for one node does not go
// through at another. (Its signer, op, issuedAt and fields are view_binding's;
// an honest nonce is fresh, so the nonce names the signing.)
lemma accepted_only_for_audience:
  "All V R S op n t f k #i #b #h. Accepted(V, R, S, op, n, t, f) @ #i
     & Bind(S, pk(k)) @ #b & HonestKey(k) @ #h
     & not (Ex #r. Compromised(k) @ #r & #r < #i)
     ==> Ex S2 op2 t2 f2 #j. Signed(S2, R, op2, n, t2, f2) @ #j & #j < #i"

// An honest proof presented again to the verifier that accepted it is turned
// away as a replay: no_burn speaks about something that happens.
lemma executable_replay_rejected:
  exists-trace
  "Ex V R S k op n t f #b #i #j. HonestDID(S, k) @ #b
     & Accepted(V, R, S, op, n, t, f) @ #i
     & ReplayRejected(V, R, S, op, n, t, f) @ #j & #i < #j
     & not (Ex k2 #r. Compromised(k2) @ #r)"

// (2) A verifier accepts a signer's nonce once. This restates the store's
// check-and-set (restriction NonceStore) for accepted proofs.
lemma once_per_store:
  "All V R S op1 n t1 f1 op2 t2 f2 #i #j. Accepted(V, R, S, op1, n, t1, f1) @ #i
     & Accepted(V, R, S, op2, n, t2, f2) @ #j ==> #i = #j"

// (2) The store's scope is per signer (D-w10): one verifier accepts one nonce
// for two signers.
lemma nonce_per_signer:
  exists-trace
  "Ex V R S1 S2 op1 op2 n t1 t2 f1 f2 #i #j. Accepted(V, R, S1, op1, n, t1, f1) @ #i
     & Accepted(V, R, S2, op2, n, t2, f2) @ #j & not (S1 = S2)"

// (3) An honest proof is turned away as a replay only when that very proof
// was accepted before, or its signer's key was taken over: a forgery spends
// no legitimate signer's nonce.
lemma no_burn:
  "All V R S op n t f #i #s. ReplayRejected(V, R, S, op, n, t, f) @ #i
     & Signed(S, R, op, n, t, f) @ #s
     ==> (Ex #j. Accepted(V, R, S, op, n, t, f) @ #j & #j < #i)
       | (Ex k #b #r. HonestDID(S, k) @ #b & Compromised(k) @ #r & #r < #i)"

// What the audience leaves: one proof accepted at two verifiers that have the
// same audience (replicas with stores of their own). One verifier per
// audience closes it (verification/README.md).
lemma replay_across_replicas:
  exists-trace
  "Ex V1 V2 R S k op n t f #b #i #j. HonestDID(S, k) @ #b
     & Accepted(V1, R, S, op, n, t, f) @ #i
     & Accepted(V2, R, S, op, n, t, f) @ #j & not (V1 = V2)
     & not (Ex k2 #r. Compromised(k2) @ #r)"

end
