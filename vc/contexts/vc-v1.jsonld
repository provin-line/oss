{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "dplaax": "https://dplaax.dev/vocab#",
    "PipelinePassCredential": "dplaax:PipelinePassCredential",
    "pipelineId": "dplaax:pipelineId",
    "processId": "dplaax:processId",
    "transformationClaim": {
      "@id": "dplaax:transformationClaim",
      "@type": "@vocab"
    },
    "schema": "dplaax:schema",
    "contentHash": "dplaax:contentHash",
    "inputHash": "dplaax:inputHash",
    "outputHash": "dplaax:outputHash",
    "previousCredential": "dplaax:previousCredential",
    "derived_from": "dplaax:derivedFrom",
    "source_root": "dplaax:sourceRoot",
    "source_root_canonical": "dplaax:sourceRootCanonical",
    "DelegationCredential": "dplaax:DelegationCredential",
    "delegatedBy": "dplaax:delegatedBy",
    "scope": "dplaax:scope"
  }
}
